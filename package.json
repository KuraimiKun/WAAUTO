{
  "name": "wabot",
  "version": "1.0.0",
  "description": "WhatsApp automation bot using Baileys",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "docker:restart": "docker-compose restart postgres",
    "docker:clean": "docker-compose down -v"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.0",
    "csv-parser": "^3.0.0",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "connect-pg-simple": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "pino": "^8.16.2",
    "qrcode": "^1.5.3",
    "pg": "^8.11.3",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.10.9",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  }
}
